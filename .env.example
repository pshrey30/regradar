# ── App ──────────────────────────────────────────────
ENV=development
APP_SECRET_KEY=
LOG_LEVEL=INFO

# ── Database (Supabase Postgres + pgvector) ─────────────
DATABASE_URL=
DATABASE_POOL_SIZE=10
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis (Celery broker + result backend) ──────────────
REDIS_URL=

# ── Object storage (raw PDFs) ───────────────────────────
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── LLM providers ────────────────────────────────────────
OPENAI_API_KEY=
HUGGINGFACE_API_TOKEN=

# ── Model routing tier thresholds ───────────────────────
TIER_HIGH_MODEL=gpt-4o
TIER_LOW_MODEL=granite-13b
TIER_ROUTING_RISK_THRESHOLD=high
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
RAG_RETRIEVAL_TOP_K=5

# ── Local inference — portfolio/demo cost control (ADR-05) ──────
USE_LOCAL_LLM=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_LOW_MODEL=llama3.2:1b
USE_LOCAL_HF_INFERENCE=false
USE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ── Ingestion sources ────────────────────────────────────
SEC_EDGAR_USER_AGENT=
SEC_EDGAR_RATE_LIMIT_PER_SEC=10
FDA_RSS_FEED_URL=
FINRA_FEED_URL=
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
INGESTION_POLL_INTERVAL_SECONDS=300

# ── Prefect ──────────────────────────────────────────────
PREFECT_API_URL=
PREFECT_API_KEY=

# ── Delivery ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@regradar.io
DELIVERY_EMAIL_RECIPIENT=alerts@example.com
WEBHOOK_HMAC_ALGORITHM=sha256

# ── Eval & observability ─────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=regradar
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
DAILY_COST_ALERT_THRESHOLD_USD=50

# ── API / auth ────────────────────────────────────────────
API_RATE_LIMIT_PER_MINUTE_DEFAULT=60
API_KEY_HASH_ALGORITHM=bcrypt

# ── Deployment ────────────────────────────────────────────
FLY_APP_NAME_API=regradar-api
FLY_APP_NAME_WORKER=regradar-worker
PORT=8000
